# Runtime
RUNTIME_DIR=/data
SQLITE_BUSY_TIMEOUT_MS=60000
PLAYWRIGHT_HEADLESS=1
WEB3_COOKIE_SECURE=1
WEB3_COOKIE_SAMESITE=none
PORT=8080

# Mantle / subscription
PROJECT_OWNER_WALLET=0xYourTreasuryWallet
PROJECT_TREASURY=0xYourTreasuryWallet
DEMO_WALLETS=
MANTLE_RPC_URL=https://rpc.mantle.xyz
EXPLORER_API_V2_URL=https://api.etherscan.io/v2/api
EXPLORER_CHAIN_ID=5000
ETHERSCAN_API_KEY=
MONTHLY_MNT_AMOUNT=5
MONTHLY_CREDIT_AMOUNT=100
SUBSCRIPTION_DAYS=30
CREDIT_TOKEN_ADDRESS=
CREDIT_TOKEN_SYMBOL=MFC

# Optional global API defaults. Users can also save per-wallet values in the dashboard.
OPENAI_API_KEY=
WP_URL=https://your-domain.com/wp-json/wp/v2/posts
WP_JWT=
CRYPTO_PANIC=
API_ID=
API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_CHAT_IDS=
X_API_ACCESS_TOKEN=
X_BODY_MAX_CHARS=155

# Facebook Page publishing uses Meta Graph API only.
# Cookie/browser posting has been removed.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_REQUIRE_VERIFY=1
META_GRAPH_API_VERSION=v24.0

# Contract deployment only. Do not set deployer keys in public GitHub repos.
CREDIT_TOKEN_NAME=MantleFlow Credit
TOKEN_CAP=10000000
TRANSFER_BURN_FEE_BPS=200
DEPLOYER_PRIVATE_KEY=

# ERC-8004 / BlockScam Proof
# Use your public/custom domain here, not the internal Railway domain.
# Example: https://your-custom-domain.example
ENABLE_ERC8004_PROOF=
ERC8004_RPC_URL=https://rpc.mantle.xyz
ERC8004_AGENT_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
ERC8004_VALIDATION_REGISTRY=
ERC8004_VALIDATOR_ADDRESS=
ERC8004_AGENT_ID=
ERC8004_EVIDENCE_BASE_URL=https://your-public-domain.com
ERC8004_PRIVATE_KEY=
ERC8004_ONCHAIN_MIN_SCORE=70

# BlockScam safety / performance
BLOCKSCAM_SKIP_FORWARDED_POSTS=1
BLOCKSCAM_BLOCK_USER_MIN_SCORE=90
BLOCKSCAM_DELETE_USER_LINKS=1
BLOCKSCAM_VERBOSE=0
BLOCKSCAM_STARTUP_BACKFILL_LIMIT=20
BLOCKSCAM_HEALTH_LOG_SECONDS=0
BLOCKSCAM_CATCH_ALL_UPDATES=1
BLOCKSCAM_FAST_SCAN_SECONDS=0.5
BLOCKSCAM_FAST_SCAN_LIMIT=10
BLOCKSCAM_BAN_DURATION_DAYS=0
BLOCKSCAM_DELETE_OWN_TEST_MESSAGES=0

# Optional fastest moderation mode based on Telegram Bot API.
# Create a bot with BotFather, add it as group admin, and set this token.
# If omitted, the app uses Telethon user-session mode.
BLOCKSCAM_BOT_TOKEN=
BLOCKSCAM_USE_BOT_API=auto

# Storage cleanup: delete local generated images after social posting.
# This does not delete WordPress media or user config in /data/app.db.
SOCIAL_IMAGE_DELETE_AFTER_POST=1
SOCIAL_IMAGE_RETENTION_HOURS=6
SOCIAL_IMAGE_MAX_TOTAL_MB=256
DEBUG_SNAPSHOT_RETENTION_HOURS=24
